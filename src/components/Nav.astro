---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Index' },
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header" id="siteHeader">
  <div class="wrap site-header-inner">
    <a class="site-mark" href="/">KUIA<sup>®</sup></a>

    <nav class="site-nav" id="siteNav" aria-label="Main">
      {links.map((link) => (
        <a href={link.href} aria-current={link.href === '/' && path === '/' ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="site-meta">
      <span>Tallinn, EE</span>
      <span id="localTime" aria-hidden="true">--:--</span>
    </div>

    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav">Menu</button>
  </div>
</header>
